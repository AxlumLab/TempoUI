import { TempoTokens } from "theme.slint";

export global TempoMotionSettings {
    // Slint also respects the native reduced-motion setting on supported backends.
    in-out property <bool> reduced: false;
}

export component TempoPresence inherits Rectangle {
    in property <bool> active;
    in property <duration> enter-time: TempoTokens.normal;
    in property <duration> exit-time: TempoTokens.fast;
    out property <float> progress: root.active ? 1.0 : 0.0;
    out property <bool> present: root.active || root.progress > 0.0;
    callback exited();
    animate progress {
        enabled: !TempoMotionSettings.reduced;
        duration: root.active ? root.enter-time : root.exit-time;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1.0);
    }
    changed present => { if !root.present { root.exited(); } }
}

// A changed destination gets a fresh, bounded enter transition, without keeping
// an animation tick alive while the page is idle. The host owns the route stack.
export component TempoRouteMotion inherits Rectangle {
    in property <int> route-key;
    // Zero gives sibling destinations a fade without implying forward or back.
    in property <int> direction: 1;
    in property <bool> enabled: true;
    in property <length> travel: 9px;
    in property <duration> enter-time: 185ms;
    private property <bool> moving: false;
    private property <int> enter-direction: 1;
    private property <float> enter-progress: root.moving ? 0.0 : 1.0;
    out property <float> progress: root.enabled && !TempoMotionSettings.reduced ? root.enter-progress : 1.0;
    animate enter-progress {
        enabled: !root.moving && root.enabled && !TempoMotionSettings.reduced;
        duration: root.enter-time;
        easing: cubic-bezier(0.22, 0.61, 0.36, 1.0);
    }
    changed route-key => {
        if root.enabled && !TempoMotionSettings.reduced {
            root.enter-direction = clamp(root.direction, -1, 1);
            root.moving = true;
            kickoff.running = true;
        }
    }
    kickoff := Timer {
        // Give Slint one frame to apply the reset before easing in.
        interval: 16ms;
        running: false;
        triggered => { self.running = false; root.moving = false; }
    }
    clip: true;
    Rectangle {
        x: (1.0 - root.progress) * root.travel * root.enter-direction;
        width: root.width; height: root.height;
        opacity: 0.92 + 0.08 * root.progress;
        @children
    }
}
