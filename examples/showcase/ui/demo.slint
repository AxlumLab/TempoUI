import { ScrollView } from "std-widgets.slint";
import {
    TempoTheme, TempoTokens, TempoAction, TempoButton, TempoIcon, TempoIconButton, TempoNav,
    TempoSearch, TempoSlider, TempoSurface, TempoTag, TempoDestination, TempoSection, TempoDivider,
    TempoSegmentedControl, TempoTile, TempoSelectionTile, TempoProgressBar, TempoEmptyState
} from "@tempo-ui";

export struct DemoTrack {
    title: string,
    artist: string,
    record: string,
    format: string,
    duration: string,
    seconds: int,
    cover: image,
}

component Cover inherits Rectangle {
    in property <image> artwork;
    border-radius: TempoTokens.radius-sm;
    clip: true;
    background: TempoTheme.background-alt;
    Image { source: root.artwork; image-fit: cover; }
}

component TrackRow inherits TempoAction {
    in property <DemoTrack> track;
    in property <bool> active;
    in property <bool> wide;
    in property <bool> playing;
    in property <int> number;
    label: "Play " + root.track.title;
    min-height: TempoTokens.tile-min-height + 2px;
    border-radius: TempoTokens.radius-sm;
    background: root.active ? TempoTheme.primary-soft
        : root.pressed ? TempoTheme.surface-pressed
        : root.hovered ? TempoTheme.surface-alt : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        if root.wide : Text {
            width: 24px;
            text: root.number;
            color: TempoTheme.text-secondary;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Cover { artwork: root.track.cover; width: 38px; height: 38px; cross-axis-self-alignment: center; border-radius: 7px; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.track.title;
                color: root.active ? TempoTheme.primary : TempoTheme.text-primary;
                font-size: 14px;
                font-weight: 700;
                overflow: elide;
            }
            Text { text: root.track.artist; color: TempoTheme.text-secondary; font-size: 11px; overflow: elide; }
        }
        if root.wide : Text {
            width: 135px;
            text: root.track.record;
            color: TempoTheme.text-secondary;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.wide : Rectangle {
            width: 58px;
            TempoTag { label: root.track.format; x: 0px; width: self.preferred-width; }
        }
        Rectangle {
            width: 16px;
            if root.active : TempoIcon {
                source: root.playing ? @image-url("assets/pause.svg") : @image-url("assets/play.svg");
                tint: TempoTheme.primary;
                width: 16px; height: 16px;
            }
        }
        Text {
            width: 34px;
            text: root.track.duration;
            color: root.active ? TempoTheme.primary : TempoTheme.text-secondary;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component PlayerDock inherits Rectangle {
    in property <DemoTrack> track;
    in property <bool> wide;
    in property <bool> playing;
    in-out property <float> position;
    in-out property <float> volume;
    out property <string> elapsed: {
        let seconds = floor(root.position * root.track.seconds);
        let minutes = floor(seconds / 60);
        let rest = seconds - minutes * 60;
        return minutes + ":" + (rest < 10 ? "0" : "") + rest;
    }
    callback toggle();
    callback previous();
    callback next();
    callback queue();
    background: TempoTheme.surface;
    min-height: root.wide ? 76px : 65px;
    Rectangle { height: 1px; y: 0px; background: TempoTheme.border; }
    if !root.wide : Rectangle {
        height: 2px; y: 0px; x: 0px;
        width: root.width * root.position;
        background: TempoTheme.primary;
    }
    HorizontalLayout {
        padding-left: root.wide ? 22px : 12px;
        padding-right: root.wide ? 22px : 9px;
        spacing: root.wide ? 12px : 7px;
        Cover { artwork: root.track.cover; width: root.wide ? 48px : 38px; height: self.width; cross-axis-self-alignment: center; }
        VerticalLayout {
            min-width: root.wide ? 134px : 0px;
            max-width: root.wide ? 134px : 10000px;
            horizontal-stretch: root.wide ? 0 : 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.track.title; font-size: 13px; font-weight: 700; color: TempoTheme.text-primary; overflow: elide; }
            Text { text: root.track.artist; font-size: 11px; color: TempoTheme.text-secondary; overflow: elide; }
        }
        if root.wide : TempoIconButton {
            icon: @image-url("assets/prev.svg"); label: "Previous track"; size: 34px;
            width: 34px; height: 34px; cross-axis-self-alignment: center;
            activated => { root.previous(); }
        }
        TempoButton {
            icon: root.playing ? @image-url("assets/pause.svg") : @image-url("assets/play.svg");
            label: root.playing ? "Pause preview" : "Play preview"; icon-only: true;
            width: 42px; height: 42px; cross-axis-self-alignment: center;
            activated => { root.toggle(); }
        }
        TempoIconButton {
            icon: @image-url("assets/next.svg"); label: "Next track"; size: 34px;
            width: 34px; height: 34px; cross-axis-self-alignment: center;
            activated => { root.next(); }
        }
        if root.wide : Text { text: root.elapsed; width: 30px; font-size: 11px; color: TempoTheme.text-secondary; vertical-alignment: center; }
        if root.wide : TempoSlider { value <=> root.position; horizontal-stretch: 1; label: "Track position"; }
        if root.wide : Text { text: root.track.duration; width: 30px; font-size: 11px; color: TempoTheme.text-secondary; vertical-alignment: center; }
        if root.wide : TempoIcon { source: @image-url("assets/volume.svg"); width: 18px; height: 18px; cross-axis-self-alignment: center; }
        if root.wide : TempoSlider { value <=> root.volume; width: 66px; label: "Preview volume"; }
        if root.wide : TempoIconButton {
            icon: @image-url("assets/queue.svg"); label: "Open queue"; size: 34px;
            width: 34px; height: 34px; cross-axis-self-alignment: center;
            activated => { root.queue(); }
        }
    }
}

export component DemoWindow inherits Window {
    title: "Tempo UI · FMusic Next";
    preferred-width: 1180px;
    preferred-height: 820px;
    min-width: 340px;
    min-height: 480px;
    background: TempoTheme.background;
    default-font-size: 14px;

    in-out property <bool> dark <=> TempoTheme.dark;
    out property <bool> compact: root.width < TempoTokens.rail-breakpoint;
    private property <bool> extended: root.width >= TempoTokens.extended-rail-breakpoint;
    private property <length> gutter: root.compact ? 16px : 26px;
    in-out property <int> page: 0;
    in-out property <string> query;
    in-out property <int> current: 0;
    in-out property <bool> playing: false;
    in-out property <bool> keep-offline: false;
    in-out property <bool> show-button-states: true;
    in-out property <float> position: 0.34;
    in-out property <float> volume: 0.72;
    in property <[DemoTrack]> shown-tracks;
    in property <[DemoTrack]> tracks: [
        { title: "Earthly Light", artist: "FMusic Sessions", record: "After hours", format: "MP3", duration: "3:42", seconds: 222, cover: @image-url("assets/cover-0.svg") },
        { title: "Prelude", artist: "FMusic Sessions", record: "First light", format: "M4A", duration: "4:16", seconds: 256, cover: @image-url("assets/cover-1.svg") },
        { title: "Sea Glass", artist: "Northbound", record: "Coastline", format: "FLAC", duration: "3:28", seconds: 208, cover: @image-url("assets/cover-2.svg") },
        { title: "City Static", artist: "Soft Circuit", record: "Night service", format: "MP3", duration: "3:55", seconds: 235, cover: @image-url("assets/cover-3.svg") },
        { title: "Blue Hour", artist: "Northbound", record: "Coastline", format: "FLAC", duration: "5:02", seconds: 302, cover: @image-url("assets/cover-4.svg") },
        { title: "Paper Planes", artist: "Mono Field", record: "Field notes", format: "M4A", duration: "2:58", seconds: 178, cover: @image-url("assets/cover-5.svg") },
    ];
    private property <[TempoDestination]> nav-items: [
        { label: "Library", icon: @image-url("assets/library.svg"), selected-icon: @image-url("assets/library-filled.svg") },
        { label: "Search", icon: @image-url("assets/search.svg") },
        { label: "Queue", icon: @image-url("assets/queue.svg") },
        { label: "Settings", icon: @image-url("assets/settings.svg"), selected-icon: @image-url("assets/settings-filled.svg") },
    ];
    callback filter(string);
    callback choose(string);
    callback step(int);
    callback playback-changed(bool);

    VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        HorizontalLayout {
            vertical-stretch: 1;
            if !root.compact : Rectangle {
                width: root.extended ? TempoTokens.desktop-nav-rail-extended-width : TempoTokens.desktop-nav-rail-width;
                background: TempoTheme.surface;
                Rectangle { width: 1px; x: parent.width - 1px; background: TempoTheme.border; }
                VerticalLayout {
                    padding: root.extended ? 14px : 8px;
                    spacing: 21px;
                    HorizontalLayout {
                        height: 48px;
                        alignment: root.extended ? start : center;
                        spacing: 10px;
                        Rectangle {
                            width: 34px; height: 34px; cross-axis-self-alignment: center;
                            border-radius: 10px; background: TempoTheme.primary;
                            TempoIcon { source: @image-url("assets/note.svg"); tint: TempoTheme.text-inverse; width: 20px; height: 20px; }
                        }
                        if root.extended : VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "FMusic Next"; font-size: 15px; font-weight: 800; color: TempoTheme.text-primary; }
                            Text { text: "Tempo UI"; font-size: 11px; color: TempoTheme.text-secondary; }
                        }
                    }
                    TempoNav { destinations: root.nav-items; selected: root.page; extended: root.extended; selected-index(i) => { root.page = i; } }
                    Rectangle { vertical-stretch: 1; }
                    if root.extended : Rectangle {
                        height: 55px;
                        border-radius: 10px;
                        background: TempoTheme.surface-alt;
                        HorizontalLayout {
                            padding: 9px; spacing: 9px;
                            TempoIcon { source: @image-url("assets/device.svg"); width: 18px; height: 18px; cross-axis-self-alignment: center; }
                            VerticalLayout {
                                alignment: center; spacing: 2px;
                                Text { text: "Demo library"; color: TempoTheme.text-primary; font-weight: 600; font-size: 12px; }
                                Text { text: "Local sample data"; color: TempoTheme.text-secondary; font-size: 10px; }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-left: root.gutter; padding-right: root.gutter;
                    padding-top: 12px; padding-bottom: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: center; spacing: 2px;
                        Text { text: root.compact ? "FMusic Next" : "YOUR MUSIC / TEMPO UI"; color: TempoTheme.text-primary; font-size: root.compact ? 16px : 12px; font-weight: 800; }
                        if root.compact : Text { text: "Tempo UI preview"; color: TempoTheme.text-secondary; font-size: 10px; }
                    }
                    TempoTag { label: "UI PREVIEW"; variant: primary; cross-axis-self-alignment: center; }
                    TempoIconButton {
                        size: 42px; variant: outline;
                        icon: root.dark ? @image-url("assets/sun.svg") : @image-url("assets/moon.svg");
                        label: root.dark ? "Switch to light theme" : "Switch to dark theme";
                        activated => { root.dark = !root.dark; }
                    }
                }
                scroller := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content := VerticalLayout {
                        padding-left: root.gutter;
                        padding-right: root.gutter;
                        padding-top: 6px;
                        padding-bottom: 18px;
                        spacing: 16px;

                        if root.page == 0 : Rectangle {
                            clip: true;
                            height: root.compact ? 153px : 180px;
                            border-radius: TempoTokens.radius-xl;
                            Rectangle {
                                cache-rendering-hint: true;
                                background: @linear-gradient(110deg, #21284f 0%, #34467b 56%, #525f9c 100%);
                                Rectangle {
                                    x: parent.width - self.width + (root.compact ? 43px : 19px);
                                    y: root.compact ? -12px : -49px;
                                    width: root.compact ? 178px : 315px;
                                    height: self.width;
                                    clip: true;
                                    border-radius: 999px;
                                    opacity: root.compact ? 0.48 : 0.86;
                                    Image { source: @image-url("assets/cover-0.svg"); image-fit: cover; }
                                }
                            }
                            VerticalLayout {
                                padding: root.compact ? 15px : 22px;
                                alignment: center;
                                spacing: 7px;
                                Text { text: "THE LOCAL COLLECTION"; color: #bbcafa; font-size: 10px; font-weight: 800; }
                                Text { text: "Your music library"; color: #ffffff; font-size: root.compact ? 25px : 35px; font-weight: 800; }
                                Text { text: "A quiet space for your own collection."; color: #e3e9ff; font-size: root.compact ? 11px : 13px; }
                                HorizontalLayout {
                                    alignment: start;
                                    TempoButton {
                                        min-height: 32px;
                                        compact: true;
                                        label: root.playing ? "Pause preview" : "Play preview";
                                        icon: root.playing ? @image-url("assets/pause.svg") : @image-url("assets/play.svg");
                                        activated => { root.playing = !root.playing; }
                                    }
                                }
                            }
                        }
                        if root.page != 3 : VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                height: 33px; spacing: 8px;
                                Text {
                                    text: root.page == 0 ? "Tracks" : root.page == 1 ? "Search library" : "Playback queue";
                                    font-size: root.compact ? 20px : 23px; font-weight: 800;
                                    color: TempoTheme.text-primary; vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TempoTag {
                                    label: (root.page == 2 ? root.tracks.length : root.shown-tracks.length) + " tracks";
                                    cross-axis-self-alignment: center;
                                }
                            }
                            if root.page != 2 : TempoSearch {
                                icon: @image-url("assets/search.svg");
                                placeholder: "Filter by song, artist, or album";
                                text <=> root.query;
                            }
                            TempoSurface {
                                VerticalLayout {
                                    padding: 5px;
                                    if root.extended : HorizontalLayout {
                                        height: 33px; padding-left: 15px; padding-right: 17px; spacing: 10px;
                                        Text { width: 24px; text: "#"; color: TempoTheme.text-secondary; font-size: 11px; vertical-alignment: center; }
                                        Text { text: "TITLE"; color: TempoTheme.text-secondary; font-size: 11px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                        Text { width: 135px; text: "ALBUM"; color: TempoTheme.text-secondary; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        Text { width: 58px; text: "FORMAT"; color: TempoTheme.text-secondary; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        Rectangle { width: 16px; }
                                        Text { width: 34px; text: "TIME"; color: TempoTheme.text-secondary; font-size: 11px; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }
                                    }
                                    for track[index] in (root.page == 2 ? root.tracks : root.shown-tracks) : TrackRow {
                                        track: track;
                                        number: index + 1;
                                        active: track.title == root.tracks[root.current].title;
                                        playing: root.playing;
                                        wide: root.extended;
                                        activated => { root.choose(track.title); }
                                    }
                                    if root.page != 2 && root.shown-tracks.length == 0 : TempoEmptyState {
                                        icon: @image-url("assets/search.svg");
                                        title: "No matching tracks";
                                        message: "Try a different song, artist, or album.";
                                        action-label: "Clear search";
                                        action => { root.query = ""; }
                                    }
                                }
                            }
                        }
                        if root.page == 3 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "Settings"; font-size: 24px; font-weight: 800; color: TempoTheme.text-primary; }
                            TempoSection {
                                title: "Appearance";
                                VerticalLayout {
                                    padding: 14px;
                                    TempoSegmentedControl {
                                        selected: root.dark ? 1 : 0;
                                        items: [
                                            { label: "Light", icon: @image-url("assets/sun.svg") },
                                            { label: "Dark", icon: @image-url("assets/moon.svg") },
                                        ];
                                        selected-index(i) => { root.dark = i == 1; }
                                    }
                                }
                                TempoDivider {}
                                TempoTile {
                                    label: "Demo library";
                                    subtitle: "View the sample tracks";
                                    icon: @image-url("assets/library.svg");
                                    trailing-icon: @image-url("assets/chevron.svg");
                                    activated => { root.page = 0; }
                                }
                            }
                            TempoSection {
                                title: "Tempo UI component samples";
                                TempoSelectionTile {
                                    label: "Keep tracks available offline";
                                    subtitle: "Checkbox sample only";
                                    check-icon: @image-url("assets/check.svg");
                                    checked <=> root.keep-offline;
                                }
                                TempoDivider {}
                                TempoSelectionTile {
                                    label: "Show button variants";
                                    check-icon: @image-url("assets/check.svg");
                                    checked <=> root.show-button-states;
                                }
                                if root.show-button-states : VerticalLayout {
                                    padding: 12px; spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        TempoButton { label: "Primary"; compact: true; }
                                        TempoButton { label: "Secondary"; compact: true; variant: secondary; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        TempoButton { label: "Ghost"; compact: true; variant: ghost; }
                                        TempoButton { label: "Danger"; compact: true; variant: danger; }
                                    }
                                    HorizontalLayout {
                                        alignment: start; spacing: 6px;
                                        TempoTag { label: "Neutral"; }
                                        TempoTag { label: "Success"; variant: success; }
                                        TempoTag { label: "Warning"; variant: warning; }
                                        TempoTag { label: "Danger"; variant: danger; }
                                    }
                                    TempoProgressBar { value: root.position; }
                                }
                            }
                        }
                    }
                    content-height: content.preferred-height;
                }
            }
        }
        PlayerDock {
            track: root.tracks[root.current];
            wide: !root.compact;
            playing: root.playing;
            position <=> root.position;
            volume <=> root.volume;
            toggle => { root.playing = !root.playing; }
            previous => { root.step(-1); }
            next => { root.step(1); }
            queue => { root.page = 2; }
        }
        if root.compact : Rectangle {
            height: TempoTokens.bottom-tab-height;
            background: TempoTheme.surface;
            Rectangle { height: 1px; y: 0px; background: TempoTheme.border; }
            TempoNav {
                destinations: root.nav-items; selected: root.page; bottom: true;
                selected-index(i) => { root.page = i; }
            }
        }
    }
    changed query => { root.filter(root.query); }
    changed page => { scroller.content-y = 0px; }
    changed playing => { root.playback-changed(root.playing); }
}

export { TempoCatalogWindow } from "catalog.slint";
